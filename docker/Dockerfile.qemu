# Dragon Legion — QEMU Android Training Environment (Module 9)
#
# Launches QEMU-based Android emulator images for RL model training.
# The Gymnasium environment interacts with these emulators via the platform API.
#
# Based on android-emulator-container-scripts by Google.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_AVD_HOME=/root/.android/avd
ENV PATH=$PATH:$ANDROID_SDK_ROOT/emulator:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    unzip \
    ca-certificates \
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    libpulse0 \
    libnss3 \
    libnspr4 \
    libxcomposite1 \
    libxcursor1 \
    libxi6 \
    libxtst6 \
    libxss1 \
    libxrandr2 \
    libasound2 \
    libegl1 \
    libgles2 \
    qemu-kvm \
    qemu-system-arm \
    qemu-system-aarch64 \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Android SDK command-line tools
RUN mkdir -p $ANDROID_SDK_ROOT/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip commandlinetools-linux-11076708_latest.zip -d $ANDROID_SDK_ROOT/cmdline-tools && \
    mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest && \
    rm commandlinetools-linux-11076708_latest.zip

# Accept licenses and install emulator + system images
RUN yes | sdkmanager --licenses > /dev/null 2>&1 && \
    sdkmanager --install \
    "emulator" \
    "platform-tools" \
    "system-images;android-30;google_apis;x86_64" \
    "system-images;android-33;google_apis;x86_64" \
    "system-images;android-34;google_apis;x86_64"

# Create AVD images for training (various Android versions)
RUN avdmanager create avd \
    -n "pixel_4_android_11" \
    -k "system-images;android-30;google_apis;x86_64" \
    -d "pixel_4" \
    --force && \
    avdmanager create avd \
    -n "pixel_6_android_13" \
    -k "system-images;android-33;google_apis;x86_64" \
    -d "pixel_6" \
    --force && \
    avdmanager create avd \
    -n "pixel_7_android_14" \
    -k "system-images;android-34;google_apis;x86_64" \
    -d "pixel_7" \
    --force

# Copy Dragon Legion platform
COPY src/ /app/src/
COPY tests/ /app/tests/
COPY requirements.txt /app/
WORKDIR /app

# Install Python dependencies
RUN pip install --break-system-packages -r requirements.txt

# Expose ADB port for external control
EXPOSE 5555
EXPOSE 5554

# Start emulator with ADB bridge
COPY docker/start_emulator.sh /start_emulator.sh
RUN chmod +x /start_emulator.sh

CMD ["/start_emulator.sh"]
