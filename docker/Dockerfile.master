# Dragon Legion — Master Node Dockerfile
# Central FastAPI server with WebSocket dashboard

FROM python:3.12-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libusb-1.0-0 \
    usbutils \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application
COPY src/ src/
COPY config/ config/

EXPOSE 8000

CMD ["python", "-m", "dragon_legion.main", "master"]
